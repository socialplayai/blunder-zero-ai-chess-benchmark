__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.DS_Store

# Working experiment output, not evidence. Rehearsals, interrupted runs and
# junk live here and must never reach a published result. Publish a closed
# record with tools/publish_game.py, which writes to the tracked results/ path.
games/
rehearsals/

# Secrets. The benchmark reads the API key from the environment only; nothing
# below should ever exist in the repository, and if it does it stays untracked.
.env
.env.*
*.env
secrets.json
*.key
*.pem
.openai
.credentials
# Working probe output at the repository root only. Anchored with a leading
# slash on purpose: an unanchored "diagnostics/" also matches
# results/diagnostics/, which silently excluded every published diagnostic
# artifact from git while `git status` stayed clean.
/diagnostics/
